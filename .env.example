# ── Loja ─────────────────────────────────────────────────────────────
# Telefone do WhatsApp que recebe os pedidos (formato internacional, só dígitos)
NEXT_PUBLIC_WHATSAPP=5569000000000
NEXT_PUBLIC_SITE_URL=https://casadoboi.com.br

# Modo demonstração: faixa de aviso + noindex. Use "false" na loja real.
NEXT_PUBLIC_DEMO=true

# ── Frete (Melhor Envio) ─────────────────────────────────────────────
# Sem estas variáveis o site usa cotação SIMULADA, marcada na tela.
# Sandbox: https://sandbox.melhorenvio.com.br | Produção: https://melhorenvio.com.br
MELHORENVIO_URL=https://sandbox.melhorenvio.com.br
MELHORENVIO_TOKEN=
# CEP de onde a loja posta (so digitos)
FRETE_CEP_ORIGEM=68365000

